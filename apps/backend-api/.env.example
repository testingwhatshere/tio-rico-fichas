# ============================================
# BACKEND API - Environment Variables
# ============================================
# Copy this file to .env and update the values
#
# RENDER DEPLOYMENT:
# - Set these as Environment Variables in Render Dashboard
# - DATABASE_URL is auto-provided when you add a Render PostgreSQL

# ==========================================
# DATABASE (Required)
# ==========================================
# Local: postgresql://postgres:postgres@localhost:5432/game_automation
# Render: Automatically provided as DATABASE_URL when you add PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_automation"

# Direct database connection (bypasses connection pooler)
# Required for Prisma migrations when using Supabase/Neon/PgBouncer.
# If NOT using a pooler, set to the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/game_automation"

# ==========================================
# JWT AUTHENTICATION (Required)
# ==========================================
# IMPORTANT: Change this in production!
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ==========================================
# BOT INTEGRATION (Required for automation)
# ==========================================
# CRITICAL: This API key MUST match the "API Key" field in the Chrome Extension's Options page
#
# To configure:
# 1. Set a simple memorable key here (e.g., "Narciso")
# 2. Open Chrome Extension → Right-click icon → Options
# 3. Enter the SAME key in the "API Key" field
# 4. Save and restart both backend and extension
#
# For production, consider using a more secure key:
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Current key:
BOT_API_KEY="Narciso"

# ==========================================
# QUEUE SETTINGS
# ==========================================
# Minimum time (ms) between job executions
# Higher = safer but slower (30000 = 30 seconds)
QUEUE_COOLDOWN_MS="30000"

# ==========================================
# SECURITY & RATE LIMITING
# ==========================================
# Maximum amount per single credit load request
MAX_REQUEST_AMOUNT="10000"

# Maximum requests a user can make per hour
MAX_REQUESTS_PER_HOUR="10"

# ==========================================
# CORS SETTINGS
# ==========================================
# Comma-separated origins, or * for all (not recommended for production)
# Example: https://app.example.com,https://panel.example.com
CORS_ORIGIN="*"

# ==========================================
# FEATURE FLAGS
# ==========================================
# Master switch to enable/disable automation
AUTOMATION_ENABLED="true"

# ==========================================
# VALIDATOR SERVICE (Optional)
# ==========================================
# URL of the payment proof validator service (Ollama-based)
VALIDATOR_URL="http://localhost:11434"

# Minimum confidence score to auto-approve (0.0 - 1.0)
# Lower = more auto-approvals, Higher = more manual reviews
VALIDATION_THRESHOLD="0.7"

# API key for Validator App authentication
# MUST match the API key in Validator App settings
VALIDATOR_API_KEY="validator-secret-key-change-in-production"

# ==========================================
# OPERATOR PANEL (Required)
# ==========================================
# API key for Operator Panel authentication
# MUST match the API key in Operator Panel settings
OPERATOR_API_KEY="operator-secret-key-change-in-production"

# ==========================================
# REDIS (Optional - reserved for future use)
# ==========================================
# Local Redis connection
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ==========================================
# FILE UPLOADS
# ==========================================
# Directory to store uploaded payment proofs
UPLOAD_DIR="./uploads"

# Maximum file size (bytes) - 10MB default
MAX_FILE_SIZE="10485760"

# ==========================================
# CLOUDINARY (Required for payment proof uploads)
# ==========================================
# Format: cloudinary://api_key:api_secret@cloud_name
# Get from: https://console.cloudinary.com
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

# ==========================================
# AI/OCR VALIDATION
# ==========================================
# Minimum confidence score for auto-approval (0-1)
AI_CONFIDENCE_THRESHOLD="0.8"

# Days to allow for payment date validation
PAYMENT_DATE_WINDOW_DAYS="7"

# ==========================================
# LOGGING
# ==========================================
# Log level: debug, info, warn, error
LOG_LEVEL="info"

# ==========================================
# SESSION MANAGEMENT
# ==========================================
# Session secret for cookies
SESSION_SECRET="change-this-session-secret-in-production"

# Session max age (milliseconds) - 24 hours default
SESSION_MAX_AGE="86400000"

# ==========================================
# SECURITY
# ==========================================
# Bcrypt password hashing rounds
BCRYPT_ROUNDS="10"

# Rate limiting (requests per window)
RATE_LIMIT_TTL="60000"   # 1 minute
RATE_LIMIT_MAX="100"     # max requests

# ==========================================
# NOTIFICATION SETTINGS
# ==========================================
# Enable/disable different notification types
NOTIFY_VALIDATION_FAILED="true"
NOTIFY_JOB_FAILED="true"
NOTIFY_NEW_REQUEST="true"

# ==========================================
# TELEGRAM NOTIFICATIONS (Optional)
# ==========================================
# Alerts to operators via Telegram bot. Without this, Telegram is silently disabled.
# Create bot via @BotFather, copy token. Chat ID = operator group/chat ID.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ==========================================
# APPLICATION
# ==========================================
# Environment: development, production, test
NODE_ENV="development"

# Port to run the server on (Render sets this automatically)
PORT="3000"

# ==========================================
# DATABASE SEED CONFIGURATION
# ==========================================
# Mode: "production" = essential data only, "demo" = everything (default: demo)
SEED_MODE="demo"

# Initial admin credentials (used by seed script)
SEED_ADMIN_EMAIL="admin@platform.com"
SEED_ADMIN_PASSWORD="admin123"

# Initial operator credentials (used by seed script)
SEED_OPERATOR_EMAIL="operator@platform.com"
SEED_OPERATOR_PASSWORD="operator123"

# Initial panel name
SEED_PANEL_NAME="Panel Principal"

# ==========================================
# MONITORING (Client Manager)
# ==========================================
# API key for Client Manager remote monitoring
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
MONITORING_API_KEY=""
