{
  "manifest_version": 3,
  "name": "Tio Rico Bot",
  "version": "1.0.2",
  "description": "Tio Rico - Carga automatica de fichas",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "cookies",
    "tabs",
    "notifications",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/humanize.js",
        "content/panel-automation.js"
      ],
      "matches": ["https://*/*"]
    }
  ]
}
