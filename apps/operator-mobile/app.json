{
  "expo": {
    "name": "Operator Panel",
    "slug": "operator-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "operator-mobile",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#151921"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tiorico.operator"
    },
    "android": {
      "package": "com.tiorico.operator",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#151921"
      },
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen"
    ]
  }
}