# Validador de comprobantes — modo servidor (Render Background Worker).
#
# Se construye SOLO con este directorio como contexto, nunca desde la raíz del
# monorepo: la raíz fija binarios de win32 (sharp, @napi-rs/canvas) que rompen
# `npm install` en Linux. Las dependencias salen de server/package.json, con
# versiones exactas y su propio lockfile.
#
#   docker build --platform linux/amd64 -f Dockerfile.server \
#     -t finnegansadmin/tiorico-validador:<version> /ruta/absoluta/apps/validator-app
#
# glibc (bookworm) y no alpine: los binarios precompilados de sharp y de
# @napi-rs/canvas (render de PDF) son para glibc.
FROM node:22-bookworm-slim

# MALLOC_ARENA_MAX: con el default de glibc, sharp (libvips, multihilo) fragmenta
# la memoria y el proceso crece sin techo dentro del contenedor.
ENV NODE_ENV=production \
    DATA_DIR=/tmp/validador \
    MALLOC_ARENA_MAX=2 \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /app

COPY --chown=node:node server/package.json server/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
 && npm cache clean --force \
 && chown -R node:node /app

# El modelo de español va en la imagen: sin él Tesseract lo bajaría de un CDN
# en cada arranque.
COPY --chown=node:node spa.traineddata ./spa.traineddata
COPY --chown=node:node src ./src
COPY --chown=node:node server/bench.js ./server/bench.js

USER node

# node es PID 1: maneja SIGTERM él mismo (apagado ordenado en src/headless.js).
CMD ["node", "src/headless.js"]
