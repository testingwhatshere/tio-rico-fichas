# Expo Router Configuration
EXPO_ROUTER_APP_ROOT=./app

# Backend API Configuration
# IMPORTANT: Must include /api suffix (backend has global prefix)
EXPO_PUBLIC_API_URL=http://192.168.100.19:3000/api
EXPO_PUBLIC_API_TIMEOUT=30000

# Socket.IO Configuration
# Note: Socket.IO connects to root, not /api
EXPO_PUBLIC_SOCKET_URL=http://192.168.100.19:3000
EXPO_PUBLIC_SOCKET_PATH=/socket.io
EXPO_PUBLIC_SOCKET_RECONNECTION=true
EXPO_PUBLIC_SOCKET_RECONNECTION_ATTEMPTS=5
EXPO_PUBLIC_SOCKET_RECONNECTION_DELAY=1000

# File Upload Configuration
EXPO_PUBLIC_MAX_FILE_SIZE_MB=10
EXPO_PUBLIC_ALLOWED_FILE_TYPES=image/png,image/jpeg,application/pdf

# App Configuration
EXPO_PUBLIC_APP_NAME="Game Automation Chat"
EXPO_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
EXPO_PUBLIC_ENABLE_DEBUG_MODE=false
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=false

# Security
EXPO_PUBLIC_SECURE_STORE_KEY_PREFIX=game_automation_
