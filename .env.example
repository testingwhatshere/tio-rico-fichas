# ============================================
# ROOT ENVIRONMENT VARIABLES
# ============================================
# These are used by docker-compose and shared across services.
# Copy this to .env and update values.

# JWT Secret (shared between services)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Bot API Key (must match in backend and bot)
BOT_API_KEY="your-bot-api-key-change-in-production"

# Database (if running backend outside Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_automation"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

// Agregar numero de whatsapp en una burbuja como para que sea de soporte en la chat app, asi la gente tiene otro canal
// Agregar opcion desde el panel de operadores para que el operador pueda configurar un numero de whatsapp para soporte, y que ese numero se muestre en la chat app como una burbuja de contacto para soporte, asi los usuarios tienen otro canal de comunicacion para resolver sus dudas o problemas.
// En la chat app que aparezca un boton de hablar a soporte por whatsapp
