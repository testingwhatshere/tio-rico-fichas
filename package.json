{
    "name": "game-automation-platform",
    "private": true,
    "version": "0.1.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "bun run --filter '*' dev",
        "build:all": "./scripts/build-all.sh",
        "build:backend": "cd apps/backend-api && bun run build",
        "build:chat": "cd apps/chat-app && npx expo export --platform web",
        "build:validator": "cd apps/validator-app && bun run build",
        "build:operator": "cd apps/operator-panel && bun run build",
        "build:extension": "cd apps/automation-extension && bun run package",
        "build:landing": "cd apps/landing-page && echo 'Landing page is static - ready to deploy'",
        "deploy:landing": "cd apps/landing-page && vercel --prod",
        "test:e2e": "npx playwright test --config tests/e2e/playwright.config.ts",
        "test:e2e:ui": "npx playwright test --config tests/e2e/playwright.config.ts --ui",
        "test:e2e:headed": "npx playwright test --config tests/e2e/playwright.config.ts --headed"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "ajv": "^8.18.0",
        "expo-modules-core": "^2.2.3",
        "prisma": "^7.2.0",
        "vite": "^5.4.14"
    },
    "dependencies": {
        "@playwright/mcp": "^0.0.68",
        "@prisma/client": "^7.2.0",
        "electron": "^33.0.0",
        "playwright": "^1.58.2"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
